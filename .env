ARTIFACT_PATH=artifacts_input          # Dont specify the last /
SCAN_OUTPUT_PATH=scans_output          # Dont specify the last /
VELOCIRAPTOR_EVIDENCE_PATTERN="^Collection-[^.]+\.zip"
VELOCIRAPTOR_EVIDENCE_PASSWORD=''
## ELASTICSEARCH INSTANCE
KIBANA_HOST="http://{yourIP}:5601"     # It's necessary to set your LAN IPv4 if ES is in docker or different network
ES_HOST="http://{yourIP}:9200"         # It's necessary to set your LAN IPv4 if Kibana is in docker or different network
ES_USER=""
ES_PASSWORD=""
## ARTIFACTS PATTERN
EVTX_PATTERN=".evtx"                   # Possible to have multiple extensions separated by comma ".evtx,.evtx.backup"
