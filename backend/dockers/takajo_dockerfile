#########################################################
#         TAKAJO Dockerfile
#
# This Dockerfile builds the Chainsaw container.
# To build the container, run:
# docker build . -t takajo -f takajo_dockerfile --no-cache
#
# Example URL for Takajo release:
# https://github.com/Yamato-Security/takajo/releases/download/v2.7.1/takajo-2.7.1-lin-x64-gnu.zip
#########################################################

# Define the Python version to use
ARG PYTHON_VERSION="3.12-slim"

# Use the specified Python version as the base image
FROM "python:${PYTHON_VERSION}"

# Define installation prefix, Chainsaw URL, and architecture
ARG TAKAJO_INSTALL_PREFIX="/opt/takajo"
ARG TAKAJO_URL="https://api.github.com/repos/Yamato-Security/takajo/releases/latest"

# Define the architecture to use : x86_64, aarch64
ARG ARCHITECTURE="x64"

# Update package list and install necessary packages
ENV DEBIAN_FRONTEND noninteractive
RUN apt-get update && \
    apt-get install --yes --no-install-recommends \
    curl git wget jq libpcre3 unzip && \
    apt-get autoremove --purge --yes && \
    rm -rf /var/lib/apt/lists/*

# Set the working directory
WORKDIR "${TAKAJO_INSTALL_PREFIX}"

# Download the latest takajo release for the specified architecture
# curl -sL "https://api.github.com/repos/Yamato-Security/takajo/releases/latest" | jq -r '.assets[] | select(.name? | match("-lin-'x64'-gnu.zip$")) | .browser_download_url'
RUN wget -O takajo.zip `curl -sL "${TAKAJO_URL}" | jq -r '.assets[] | select(.name? | match("-lin")) | .browser_download_url'`


# Extract the downloaded tarball and remove it
RUN unzip takajo.zip && \
    rm -rf *.zip 

# Set the working directory to takajo
WORKDIR "${TAKAJO_INSTALL_PREFIX}/"
RUN ln -s takajo-*-gnu takajo && \
    chmod +x takajo*

# Define the entry point and default command for the container
ENTRYPOINT ["./takajo"]
CMD ["--help"]
