#########################################################
#         Elastic-Logstash Dockerfile
#
# This Dockerfile builds the logstash container.
# To build the container, run:
# docker build . -t logstash -f logstash_dockerfile --no-cache
# docker run --network=elastic -v <PWD>:/opt/data/ logstash
#
#########################################################


FROM docker.elastic.co/logstash/logstash:8.15.0

# delete default configuration
RUN rm -f /usr/share/logstash/pipeline/logstash.conf

# Install prune filter
RUN /usr/share/logstash/bin/logstash-plugin install logstash-filter-prune

# copy configurations
COPY dockers/configurations/logstash/pipeline /usr/share/logstash/pipeline/
#COPY ./config/ /usr/share/logstash/config/
