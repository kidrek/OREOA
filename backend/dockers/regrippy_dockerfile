#########################################################
#         Regrippy Dockerfile
#
# This Dockerfile builds the Hayabusa container.
# To build the container, run:
# docker build . -t hayabusa -f hayabusa_dockerfile
#
# Example URL for Hayabusa release:
# https://github.com/Yamato-Security/hayabusa/releases/download/v2.17.0/hayabusa-2.17.0-linux-intel.zip
#########################################################

# Define the Python version to use
ARG PYTHON_VERSION="3.8"

# Use the specified Python version as the base image
FROM "python:${PYTHON_VERSION}"

ENV DEBIAN_FRONTEND=noninteractive
# Combining the apt-get commands into a single run reduces the size of the resulting image.
# The apt-get installations below are interdependent and need to be done in sequence.
RUN apt-get -y update && \
    apt-get -y upgrade && \
    apt install -y git-core python3-setuptools && \
    apt-get autoremove --purge --yes && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /opt/
RUN git clone https://github.com/airbus-cert/regrippy

WORKDIR /opt/regrippy
RUN pip3 install -r requirements.txt && \
    pip3 install . && \
    chmod +x regrip.py

# Define the entry point and default command for the container
WORKDIR /opt/regrippy
ENTRYPOINT ["regrip.py"]
CMD ["--help"]
