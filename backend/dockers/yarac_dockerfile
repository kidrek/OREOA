#########################################################
#         YARA Dockerfile
#
# This Dockerfile builds the Chainsaw container.
# To build the container, run:
# docker build . -t yarac -f yarac_dockerfile --no-cache
#
# To use this container, run :
# docker run -v <PWD>:/opt/yara yarac -w /opt/yara/rules_index.yar  /opt/yara/rules_compiled.yac
#
#########################################################

# Define the Python version to use
#ARG PYTHON_VERSION="3.12-slim"

# Use the specified Python version as the base image
#FROM "python:${PYTHON_VERSION}"
FROM ubuntu

# Define installation prefix
ARG YARA_INSTALL_PREFIX="/opt/yara"

# Update package list and install necessary packages
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && \
    apt-get install --yes --no-install-recommends yara && \
    apt-get autoremove --purge --yes && \
    rm -rf /var/lib/apt/lists/*

# Set the working directory
WORKDIR "${YARA_INSTALL_PREFIX}"

# Define the entry point and default command for the container
ENTRYPOINT ["yarac"]
CMD ["-h"]
